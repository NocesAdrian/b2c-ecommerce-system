# PROJECT NAME
COMPOSE_PROJECT_NAME=template_app

# IMAGES
DATABASE_IMAGE=docker.io/library/mysql:8.4.6
PHPMYADMIN_IMAGE=docker.io/library/phpmyadmin:5.2.3
ADMINER_IMAGE=docker.io/library/adminer:5.4.2

# MOUNT PORTS TO HOST
SERVER_MOUNTPORT_1=8081:80/tcp
ADMINER_MOUNTPORT_1=8082:8080/tcp
PHPMYADMIN_MOUNTPORT_1=8083:80/tcp

# CONTEXT PATH
SERVER_CONTEXT_PATH=../

# DOCKER PATH
SERVER_DOCKERFILE_PATH=infra/containers/php/Dockerfile

# WORK DIRECTORY INSIDE CONTAINER
SERVER_WORKDIR=/var/www/html

# VOLUME MOUNTS
SERVER_MOUNTDIR=../server:/var/www/html:z
DATABASE_MOUNTDIR=../database:/var/lib/mysql:Z
CLIENT_ORIGIN=http://127.0.0.1:5500

# Optional Gemini-powered customer service. Keep the API key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# DATABASE CONFIG
DATABASE_ROOT_PASSWORD=root
DATABASE_DATABASE=b2c_ecommerce_db
DATABASE_USER=b2c_app
DATABASE_PASSWORD=b2c_app_local
DATABASE_PORT=3306
